{
  "name": "@kehto/mocks",
  "version": "0.1.2",
  "description": "Deterministic mock services for every napplet NAP domain — in-memory data for shells implementing NAPs without real relays, devices, or providers",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kehto/acl": "workspace:^",
    "@kehto/runtime": "workspace:^"
  },
  "peerDependencies": {
    "@napplet/core": ">=0.32.0 <0.41.0",
    "@napplet/nap": ">=0.32.0 <0.40.0"
  },
  "devDependencies": {
    "@napplet/core": ">=0.40.0 <0.41.0",
    "@napplet/nap": ">=0.39.0 <0.40.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --config ../../vitest.config.ts packages/mocks",
    "audit:naps": "node scripts/audit-naps.mjs",
    "docs:table": "node scripts/render-domain-table.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kehto/web.git",
    "directory": "packages/mocks"
  },
  "keywords": [
    "nostr",
    "napplet",
    "kehto",
    "mocks",
    "testing"
  ]
}
